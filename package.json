{
  "name": "claw3d-sample",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Standalone step-by-step Claw3D office sample. No OpenClaw gateway required — just npm run dev.",
  "scripts": {
    "dev": "next dev --port 5051",
    "build": "next build",
    "start": "next start --port 5050",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "demo-gateway": "node scripts/no-gateway-needed.mjs demo-gateway",
    "hermes-adapter": "node scripts/no-gateway-needed.mjs hermes-adapter",
    "doctor": "node scripts/no-gateway-needed.mjs doctor",
    "studio:setup": "node scripts/no-gateway-needed.mjs studio:setup",
    "fetch:doctor-model": "node scripts/fetch-doctor-model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "framer-motion": "^13.1.1",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
